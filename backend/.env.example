APP_ENV=development
APP_PORT=8081
APP_SECRET_KEY=change-me-to-a-32-byte-secret!!
DEFAULT_FACILITY_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# Administrative Access Credentials (stored in ENV, never in code)
ADMIN_EMAIL=admin@antrisehat.id
ADMIN_USERNAME=admin

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antri_sehat
DB_USER=postgres
DB_PASSWORD=
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Security & Encryption (Hex-encoded 32-byte / 64-char hex key for AES-256)
NIK_ENCRYPTION_KEY=bee4f5ae9ad5673e451a601b57332a083d670e1be6b2b9ec8e6e1bc230188680
BCRYPT_COST=12

# Session Expiry (default 8 hours)
JWT_ACCESS_EXPIRE=8h
JWT_REFRESH_EXPIRE=168h

# Rate Limiting (max 3 requests per session, then timeout)
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_TIMEOUT=60s

# Notifications
NOTIF_GATEWAY_URL=
NOTIF_GATEWAY_TOKEN=
